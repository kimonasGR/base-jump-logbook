# Copy to .env locally. Never commit real values.
PORT=8787
NODE_ENV=development
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
# Private Neon Object Storage credentials (pull from the linked Neon branch; never commit real values)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=eu-central-1
NEON_STORAGE_BUCKET=base-jump-media
# Neon Auth JWKS URL from your Neon Auth configuration
NEON_AUTH_JWKS_URL=https://ep-young-truth-badvxgct.neonauth.c-8.eu-central-1.aws.neon.tech/neondb/auth/.well-known/jwks.json
# Issuer must match the `iss` claim on access tokens from your auth provider
NEON_AUTH_ISSUER=https://ep-young-truth-badvxgct.neonauth.c-8.eu-central-1.aws.neon.tech/neondb/auth
OPENAI_API_KEY=
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
OPENAI_EXTRACT_MODEL=gpt-4.1-mini
# Optional exact origin for browser front-end, e.g. http://localhost:8000
CORS_ORIGIN=http://localhost:8000
